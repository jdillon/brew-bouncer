{
  "src": [
    "src/**/*.ts"
  ],
  "path": ".license-header.txt",
  "ignore": [
    ".DS_Store",
    ".gitignore",
    ".editorconfig",
    ".gitattributes",
    ".claude/**/*",
    ".moon/**/*",
    ".idea/**/*",
    "node_modules/**/*",
    "bin/**/*",
    "dist/**/*",
    "tmp/**/*",
    "sandbox/**/*",
    "docs/**/*",
    "**/*.d.ts",
    "**/*.md",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.lock",
    "src/build-info.ts",
    "scripts/workspace-setup",
    ".github/formula-template.rb",
    "**/*.bun-build"
  ],
  "license": ".license-header.txt",
  "default_format": {
    "prepend": "/*",
    "append": " */",
    "eachLine": {
      "prepend": " * "
    }
  },
  "licenseFormats": {
    "ts|js": {
      "prepend": "/*",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    }
  },
  "trailingWhitespace": "TRIM",
  "insert": "true"
}
